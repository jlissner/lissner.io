# ENV Variables that are commented out MUST be changed to a valid value

## Environment
NODE_ENV=development

## Server settings
DATA_DIR=./data
#SESSION_SECRET=123
#FIRST_ADMIN_EMAIL=admin@example.com
OLLAMA_VISION_MODEL=llava

## Ports and URLS
UI_PORT=5173
# Split-host production: set before `npm run build` so the UI bundle calls the API (e.g. https://api.lissner.io). Leave unset for local Vite proxy.
# Docker Compose Traefik hostnames (substitution in docker-compose.yml)
# VITE_API_HOST=api.lissner.io
# UI_HOST=lissner.io  # magic-link emails and browser UI (server + Traefik ui router)
#GRAPHQL_HOST=query.lissner.io  # PostGraphile GraphQL (Traefik graphql router)
# Local dev: Ollama on this machine. Traefik-only hostnames (e.g. ollama.internal) do not resolve on the host or inside the app container unless you set up DNS; see HOST.md. Docker Compose pins api→Ollama to http://ollama:11434.
OLLAMA_HOST=http://127.0.0.1:11434
SERVER_PORT=3000

## GraphQL (PostGraphile)
#GRAPHQL_PORT=5678
# Remote RDS requires TLS. Use sslmode=no-verify for dev (pg native); use sslmode=verify-full + RDS CA in production.
#DATABASE_URL=postgres://user:pass@host.rds.amazonaws.com:5432/postgres?sslmode=no-verify
#PG_SCHEMAS=public
# Signs app.jwt_token from authenticate(); must match the secret used by the previous PostGraphile v4 server.
#PG_JWT_SECRET=your-jwt-secret

## AWS settings
# AWS_ACCESS_KEY_ID=someId
# AWS_SECRET_ACCESS_KEY=someKey
AWS_REGION=us-west-2
# S3_BUCKET=example-bucket-name
# SES_FROM_EMAIL=noreply@example.com

## feature flags
DATA_EXPLORER_ENABLED=false
