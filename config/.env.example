# ENV Variables that are commented out MUST be changed to a valid value

## Environment
NODE_ENV=development

## Server settings
DATA_DIR=./data
#SESSION_SECRET=123
#FIRST_ADMIN_EMAIL=admin@example.com
OLLAMA_VISION_MODEL=llava

## Ports and hosts
PICS_UI_HOST=localhost
PICS_UI_PORT=5173
#ADMIN_UI_HOST=localhost
#ADMIN_UI_PORT=5175
SERVER_PORT=3000
# Split-host production: set before `npm run build` so the UI bundle calls the API (e.g. https://api.lissner.io).
# Docker Compose Traefik hostnames (substitution in docker-compose.yml)
# VITE_API_HOST=api.lissner.io
# PICS_UI_HOST=lissner.io
#GRAPHQL_HOST=query.lissner.io
# Local dev: Ollama on this machine. Docker Compose pins api→Ollama to http://ollama:11434.
OLLAMA_HOST=http://127.0.0.1:11434
VITE_API_HOST=localhost

## Postgres — never commit real passwords
# Two Compose instances on one machine (ADR 0008):
#   Dev  (`npm run db:up` / `npm run dev`): project lissnerio-dev
#   Prod (`npm run host`):                  project lissnerio
#
# INTERNAL_* = host bind / tools on the laptop (psql, db:checkpoint, compose ports:)
# EXPOSED_*  = what Node apps use to connect (buildDatabaseUrl)
#
# Dev example (.env.local):
#   INTERNAL_POSTGRES_HOST=127.0.0.1
#   INTERNAL_POSTGRES_PORT=5432
#   EXPOSED_POSTGRES_HOST=127.0.0.1
#   EXPOSED_POSTGRES_PORT=5432
# Prod example (.env.prod) — apps inside Compose reach the postgres service:
#   INTERNAL_POSTGRES_HOST=127.0.0.1
#   INTERNAL_POSTGRES_PORT=5433
#   EXPOSED_POSTGRES_HOST=postgres
#   EXPOSED_POSTGRES_PORT=5432
POSTGRES_USER=
# Quote if the password contains # or spaces (dotenv / compose comment rules).
POSTGRES_PASSWORD=
INTERNAL_POSTGRES_HOST=127.0.0.1
INTERNAL_POSTGRES_PORT=5432
EXPOSED_POSTGRES_HOST=127.0.0.1
EXPOSED_POSTGRES_PORT=5432
GRAPHQL_DATABASE_NAME=lissner
MEDIA_DATABASE_NAME=media
#MEDIA_TEST_DATABASE_NAME=media_test

# GraphQL (PostGraphile)
#GRAPHQL_PORT=5678
#PG_SCHEMAS=public
#PG_JWT_SECRET=

# Dump remote GraphQL DB (full URL, including DB name):
#REMOTE_DATABASE_URL=postgres://USER:PASSWORD@db.lissner.io:5432/DBNAME?sslmode=require

## AWS settings
# AWS_ACCESS_KEY_ID=someId
# AWS_SECRET_ACCESS_KEY=someKey
AWS_REGION=us-west-2
# S3_BUCKET=example-bucket-name
# SES_FROM_EMAIL=noreply@example.com

## feature flags
DATA_EXPLORER_ENABLED=false
