{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": [
        "src/db/pg-media.ts",
        "src/db/pg-backup.ts",
        "src/db/test-media-db.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/graphql": {
      "entry": ["graphile.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/pics": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["ollama"]
}
