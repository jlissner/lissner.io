{
  "name": "lissner.io",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @lissner/pics",
    "build:graphql": "tsc -b packages/shared packages/graphql",
    "build:server": "tsc -b packages/shared packages/server",
    "clear-index": "tsx scripts/clear-search-index.ts",
    "db:up": "bash scripts/docker-compose.sh up -d postgres",
    "db:down": "bash scripts/docker-compose.sh stop postgres",
    "db:checkpoint": "npm run checkpoint -w @lissner/db",
    "db:dump-remote": "npm run dump-remote -w @lissner/db",
    "db:restore-local": "npm run restore-local -w @lissner/db",
    "db:migrate:media": "npm run migrate:media -w @lissner/db",
    "db:etl": "npm run etl -w @lissner/db",
    "db:verify-etl": "npm run verify-etl -w @lissner/db",
    "dev": "concurrently -n ollama,server,ui,graphql -c yellow,blue,green,magenta \"ollama serve\" \"npm run dev:server\" \"npm run dev:ui\" \"npm run dev:graphql\"",
    "dev:graphql": "npm run dev -w @lissner/graphql",
    "dev:server": "npm run dev -w @lissner/server",
    "dev:ui": "npm run dev -w @lissner/pics",
    "dev:web": "concurrently -n server,ui \"npm run dev:server\" \"npm run dev:ui\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:local": "concurrently -n ollama,server,ui \"ollama serve\" \"npm run dev:server\" \"npm run dev:ui -- --host\"",
    "host": "npm run build && npm run host:build && npm run host:up",
    "host:build": "bash scripts/docker-compose.sh build --no-cache",
    "host:up": "bash scripts/docker-compose.sh up -d --wait",
    "host:down": "bash scripts/docker-compose.sh down",
    "host:pull": "bash scripts/docker-compose.sh exec ollama sh -lc 'ollama pull \"${OLLAMA_EMBED_MODEL:-nomic-embed-text}\" && ollama pull \"${OLLAMA_VISION_MODEL:-llava}\"'",
    "host:logs": "bash scripts/docker-compose.sh logs -f",
    "host:status": "bash scripts/docker-compose.sh ps",
    "host:config": "bash scripts/docker-compose.sh config -q",
    "validate": "npm run lint && npm test && npm run host:config",
    "deploy": "npm run validate && npm run host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "tsx scripts/nuke-everything.ts",
    "servers": "bash scripts/list-servers.sh",
    "start": "npm run start -w @lissner/server",
    "start:graphql": "npm run start -w @lissner/graphql",
    "test": "vitest run",
    "test:bdd": "npm run build:server && cucumber-js 'features/**/*.feature' --import tsx/esm --import 'features/support/test-env.ts' --import 'features/step-definitions/**/*.ts' --format progress"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1033.0",
    "better-sqlite3": "12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@cucumber/cucumber": "^12.8.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.1.0",
    "concurrently": "9.0.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.4"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
